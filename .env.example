# Claude (대본·리뷰 조사·성과 분석)
ANTHROPIC_API_KEY=
# Google Cloud TTS: 서비스 계정 키 경로
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-tts.json
TTS_PROVIDER=google      # google | none(무음 미리보기)
TTS_VOICE=ko-KR-Neural2-A
TTS_RATE=0.9
# YouTube OAuth (데스크톱 앱 클라이언트)
YT_CLIENT_SECRETS=secrets/client_secret.json
YT_TOKEN=secrets/token.json
