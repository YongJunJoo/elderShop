# Claude (대본·리뷰 조사·성과 분석)
ANTHROPIC_API_KEY=
# Google Cloud TTS: 서비스 계정 키 경로
GOOGLE_APPLICATION_CREDENTIALS=secrets/gcp-tts.json
TTS_PROVIDER=google      # google(Cloud TTS) | gemini(Gemini 음성, GEMINI_API_KEY) | none(무음 미리보기)
# GEMINI_TTS_VOICE=Kore   # Gemini 음성 이름 (Kore, Aoede, Leda, Puck 등)
# GEMINI_TTS_STYLE=밝고 또렷한 홈쇼핑 쇼호스트처럼 ...
TTS_VOICE=ko-KR-Neural2-A
TTS_RATE=1.2
# 영상 스타일: navy(네이비 홈쇼핑) | clean(클린 화이트) | warm(따뜻한 크림)
VIDEO_THEME=navy
CHANNEL_NAME=어르신 살림 가이드
# YouTube OAuth (데스크톱 앱 클라이언트)
YT_CLIENT_SECRETS=secrets/client_secret.json
YT_TOKEN=secrets/token.json
# 상품 사진 자동 수집 (둘 중 하나 이상)
COUPANG_ACCESS_KEY=
COUPANG_SECRET_KEY=
NAVER_CLIENT_ID=
NAVER_CLIENT_SECRET=
# AI 생활 장면 (Google AI Studio에서 발급, 결제 연결 필요)
GEMINI_API_KEY=
# GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# AI 장면 이미지: manual(기본, 무료: Flow·Gemini 앱에서 직접 만들어 ai_images/ 에 저장) | gemini(유료 API 자동)
# 비워두면 GEMINI_API_KEY가 있을 때 gemini, 없으면 manual
IMAGE_SOURCE=
VEO_MODEL=veo-3.1-fast-generate-preview
# 형식 섞기: 이미지형 2 : 영상형 1 (slides도 넣을 수 있음, 예: aiimage:2,ai:1,slides:1)
FORMAT_MIX=aiimage:2,ai:1
# 영상형 소스: flow(무료, 직접 받아 out/<slug>/flow/에 넣기) | veo(유료 자동, 8초 약 1~3달러)
VIDEO_SOURCE=flow

# 배경음악: Flow Music으로 만든 곡을 assets/bgm/(bright|calm|funny)/ 에 넣기. 끄려면 BGM=off
BGM_VOLUME=0.25
